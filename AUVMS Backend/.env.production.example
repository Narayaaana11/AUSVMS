# .env.example - Copy to .env and fill in your values

# ============================================================================
# DEPLOYMENT ENVIRONMENT
# ============================================================================
NODE_ENV=production
# NODE_ENV options: development, production, staging

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=5000

# ============================================================================
# DATABASE - MongoDB
# ============================================================================
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/auvms
# Local: mongodb://username:password@localhost:27017/auvms
# Never use @ in password - URL encode it (e.g., @ becomes %40)
MONGO_URI=mongodb://admin:password@localhost:27017/auvms
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=secure_password_here

# ============================================================================
# CACHE - Redis
# ============================================================================
# Local: redis://localhost:6379
# Cloud (separate port): redis://user:password@host:port
REDIS_URL=redis://localhost:6379

# ============================================================================
# AUTHENTICATION - JWT Secrets (MUST be generated - NOT defaults!)
# ============================================================================
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars_change_this
JWT_EXPIRE=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_min_32_chars_change_this
REFRESH_TOKEN_EXPIRE=7d

# ============================================================================
# FRONTEND - CORS Configuration
# ============================================================================
# Production: https://your-domain.com
# Development: http://localhost:3000
CLIENT_URL=http://localhost:3000

# ============================================================================
# EMAIL / SMTP Configuration
# ============================================================================
# For Gmail: Use App Passwords (NOT main password)
# See: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your_app_password_here

# Alternative SMTP providers:
# Outlook: smtp-mail.outlook.com:587 (SMTP_SECURE=false)
# SendGrid: smtp.sendgrid.net:587 (SMTP_SECURE=false)

# ============================================================================
# NOTIFICATION SYSTEM - Encryption & Redis Queue
# ============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTIF_ENC_SECRET=a1b2c3d4e5f6789012345678901234567890abcdefabcdefabcdefabcdefabcd

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=info
# LOG_LEVEL options: error, warn, info, http, debug
# LOG_FILE=/var/log/auvms-backend.log  # Optional: file logging

# ============================================================================
# FILE UPLOAD
# ============================================================================
MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif

# ============================================================================
# SESSION & COOKIES
# ============================================================================
# Set to true in production with HTTPS
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# ============================================================================
# EXTERNAL SERVICES (Optional)
# ============================================================================

# SMS Gateway (Twilio, AWS SNS, etc.)
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# Cloud Storage (AWS S3, Google Cloud Storage, etc.)
# STORAGE_PROVIDER=aws_s3
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_BUCKET_NAME=your_bucket_name
# AWS_REGION=us-east-1

# ============================================================================
# MAINTENANCE & DEVELOPMENT
# ============================================================================
# Only use for development/testing - NEVER in production
SEED_ADMIN_PASSWORD=Aditya@123
SEED_STAFF_PASSWORD=Aditya@123
SEED_GUARD_PASSWORD=Aditya@123

# ============================================================================
# MONITORING (Optional)
# ============================================================================
# Sentry Error Tracking
# SENTRY_DSN=your_sentry_dsn

# ============================================================================
# SECURITY
# ============================================================================
# Rate limiting (requests per time window)
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Bcrypt password hashing cost (10-12 recommended for production)
BCRYPT_ROUNDS=10
