# Aditya University Visitor Management System - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
NODE_ENV=development
PORT=5000

# ============================================================================
# DATABASE - MongoDB Atlas or local
# ============================================================================
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
# Never use @ in password - URL encode it (e.g., @ becomes %40)
MONGO_URI=mongodb://localhost:27017/auvms

# ============================================================================
# AUTHENTICATION - JWT Secrets
# ============================================================================
# Generate strong secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRE=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_min_32_chars
REFRESH_TOKEN_EXPIRE=7d

# ============================================================================
# FRONTEND - CORS Configuration
# ============================================================================
# Comma-separated list of allowed origins (e.g., http://localhost:3000,https://example.com)
CLIENT_URL=http://localhost:3000

# ============================================================================
# EMAIL / SMTP Configuration
# ============================================================================
# For Gmail: Use App Passwords (not your main password)
# See: https://myaccount.google.com/apppasswords
USE_ETHEREAL=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Alternative SMTP providers:
# Outlook: smtp-mail.outlook.com:587 (SMTP_SECURE=false)
# SendGrid: smtp.sendgrid.net:587 (SMTP_SECURE=false)

# ============================================================================
# NOTIFICATION SYSTEM - Redis Queue & Encryption
# ============================================================================
# Redis connection string (local or cloud)
REDIS_URL=redis://localhost:6379

# Encryption secret for notification credentials (generate with crypto.randomBytes)
NOTIF_ENC_SECRET=a1b2c3d4e5f6789012345678901234567890abcdefabcdefabcdefabcdefabcd

# ============================================================================
# DEVELOPMENT/TESTING - Seeding Passwords
# ============================================================================
# Only used for development. Change for production seeding scripts.
SEED_ADMIN_PASSWORD=Aditya@123
SEED_STAFF_PASSWORD=Aditya@123
SEED_GUARD_PASSWORD=Aditya@123

# ============================================================================
# LOGGING - Optional
# ============================================================================
LOG_LEVEL=info
# LOG_FILE=/var/log/auvms-backend.log

# ============================================================================
# FILE UPLOAD - Optional Configuration
# ============================================================================
MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif

# ============================================================================
# SESSION & COOKIES
# ============================================================================
# Set to true in production with HTTPS
COOKIE_SECURE=false

# ============================================================================
# EXTERNAL SERVICES (Optional)
# ============================================================================
# SMS Gateway (Twilio, AWS SNS, etc.)
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token

# Cloud Storage (AWS S3, Google Cloud Storage, etc.)
# CLOUD_STORAGE_PROVIDER=aws_s3
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_BUCKET_NAME=your_bucket
